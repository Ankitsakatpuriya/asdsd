                                  {
                                    "name": "usageType",
                                    "type": [
                                      "null",
                                      "string"
                                    ]
                                  }
                                ]
                              }
                            },
                            {
                              "name": "digitalAddresses",
                              "type": {
                                "type": "array",
                                "items": "DigitalAddressData"
                              }
                            },
                            {
                              "name": "internalIdentifiers",
                              "type": {
                                "type": "array",
                                "items": "Identifier"
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
