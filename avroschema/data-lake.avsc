{
  "type": "record",
  "name": "BankGuaranteesDataLakeEvent",
  "namespace": "com.ing.bankguarantees.avro",
  "doc": "This schema represents a bank guarantee event.",
  "fields": [
    {
      "name": "header",
      "type": {
        "type": "record",
        "name": "Header",
        "fields": [
          {
            "name": "eventId",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "GUID (UUID) of the event in order to make it globally identifiable"
          },
          {
            "name": "sessionId",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "The sessionId as provided by an access token"
          },
          {
            "name": "traceId",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "Identifier which is set commonly to a number of events belonging to the same context (tree of execution)"
          },
          {
            "name": "source",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "The source hostname of the message producer"
          },
          {
            "name": "created",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "Event time creation"
          },
          {
            "name": "eventName",
            "type": {
              "type": "enum",
              "name": "EventName",
              "symbols": [
                "CREATED",
                "DRAFT",
                "SIGN_INITIATED",
                "PARTIALLY_SIGNED",
                "SIGNED",
                "CANCELED",
                "FULFILLED",
                "FULFILMENT_STARTED",
                "FULFILMENT_ERROR",
                "ERROR"
              ]
            },
            "doc": "The name of the event in order to indicate the business fact"
          },
          {
            "name": "confidentiality",
            "type": "int",
            "doc": "Confidentiality level (1..4) of the information contained in the event, aligned with the level included in the TPA Message Headers. It's duplicated so the event is self contained"
          },
          {
            "name": "version",
            "type": {
              "type": "string",
              "avro.java.string": "String"
            },
            "doc": "The version of the event definition"
          }
        ]
      },
      "doc": "Global event header"
    },
    {
      "name": "body",
      "type": {
        "type": "record",
        "name": "BankGuaranteeEventBody",
        "fields": [
          {
            "name": "id",
            "type": "string",
            "doc": "The global unique id for the bank guarantee request"
          },
          {
            "name": "status",
            "type": [
              {
                "type": "enum",
                "name": "BankGuaranteeRequestStatus",
                "symbols": [
                  "CREATED",
                  "DRAFT",
                  "SIGN_INITIATED",
                  "PARTIALLY_SIGNED",
                  "SIGNED",
                  "CANCELED",
                  "FULFILLED",
                  "FULFILMENT_STARTED",
                  "FULFILMENT_ERROR",
                  "ERROR"
                ]
              }
            ]
          },
          {
            "name": "sessionId",
            "type": "string"
          },
          {
            "name": "bgRequest",
            "type": {
              "type": "record",
              "name": "BankGuaranteeRequestData",
              "fields": [
