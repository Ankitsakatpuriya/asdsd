                            },
                            {
                              "name": "internalIdentifiers",
                              "type": {
                                "type": "array",
                                "items": {
                                  "type": "record",
                                  "name": "Identifier",
                                  "fields": [
                                    {
                                      "name": "id",
                                      "type": "string"
                                    },
                                    {
                                      "name": "type",
                                      "type": "string"
                                    },
                                    {
                                      "name": "value",
                                      "type": "string"
                                    }
