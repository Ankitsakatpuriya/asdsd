                {
                  "name": "signed",
                  "type": "boolean"
                },
                {
                  "name": "wbCustomer",
                  "type": "boolean"
                },
                {
                  "name": "stp",
                  "type": "boolean"
                },
                {
                  "name": "amountCapExceed",
