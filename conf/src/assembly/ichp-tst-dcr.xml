<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns="http://maven.apache.org/ASSEMBLY/2.0.0"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.0.0 http://maven.apache.org/xsd/assembly-2.0.0.xsd">
    <id>ichp-tst-dcr</id>
    <includeBaseDirectory>false</includeBaseDirectory>
    <formats>
        <format>zip</format>
    </formats>
    <files>
        <file>
            <source>${basedir}/src/main/common-values.yaml</source>
            <outputDirectory/>
        </file>
        <file>
            <source>${basedir}/src/main/tst/values.yaml</source>
            <outputDirectory/>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${basedir}/src/main</directory>
            <outputDirectory>./properties</outputDirectory>
            <includes>
                <include>*.*</include>
            </includes>
            <excludes>
                <exclude>common-values.yaml</exclude>
            </excludes>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/tst/binaries</directory>
            <outputDirectory>./binaries</outputDirectory>
            <includes>
                <include>*.*</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/tst/binaries/dcr</directory>
            <outputDirectory>./binaries</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/tst/properties</directory>
            <outputDirectory>./properties</outputDirectory>
            <includes>
                <include>*.*</include>
            </includes>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/tst/properties/dcr</directory>
            <outputDirectory>./properties</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${project.build.directory}/generated-resources/api-trust-tokens-keystores-${api-trust-tokens-keystores.version}-tst-zip</directory>
            <outputDirectory>./binaries</outputDirectory>
        </fileSet>
        <fileSet>
            <directory>${basedir}/src/main/tst/keyvault</directory>
            <outputDirectory>./keyvault</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
